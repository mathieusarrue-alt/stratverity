# Variables publiques du frontend uniquement.
# Copier vers .env.local pour le développement ; ne jamais y mettre de clé
# Stripe, de service-role Supabase ni de secret AWS.

NEXT_PUBLIC_BACKTESTPROOF_API_URL=https://api.stratverity.com
NEXT_PUBLIC_SITE_ORIGIN=https://www.stratverity.com
NEXT_PUBLIC_CRASH_TEST_ENABLED=false
NEXT_PUBLIC_FREE_ELIGIBILITY_ENABLED=false
NEXT_PUBLIC_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key

# Cible de build AWS Amplify ; définie par amplify.yml/GitHub Actions.
NITRO_PRESET=aws_amplify
